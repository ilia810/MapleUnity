using UnityEngine;
using UnityEditor;
using UnityEditor.SceneManagement;
using MapleClient.GameView;
using MapleClient.GameData;
using System.IO;
using System.Reflection;

public static class ForcedFaceOffsetTest
{
    public static void RunTest()
    {
        string logPath = Path.Combine(Application.dataPath, "..", "face-offset-test-results.txt");
        System.Text.StringBuilder results = new System.Text.StringBuilder();
        
        try
        {
            Debug.Log("=== FORCED FACE OFFSET TEST ===");
            results.AppendLine("=== FORCED FACE OFFSET TEST ===");
            results.AppendLine($"Test started at: {System.DateTime.Now}");
            
            // Initialize NXAssetLoader with mock data
            var mockFile = new MockNxFile();
            NXAssetLoader.Instance.RegisterNxFile("character", mockFile);
            results.AppendLine("NXAssetLoader initialized with MockNxFile");
            
            // Create a new scene
            var scene = EditorSceneManager.NewScene(NewSceneSetup.DefaultGameObjects, NewSceneMode.Single);
            
            // Create a MapleCharacter
            Debug.Log("Creating MapleCharacter...");
            results.AppendLine("\nCreating MapleCharacter...");
            
            var characterObj = new GameObject("MapleCharacter");
            var renderer = characterObj.AddComponent<MapleCharacterRenderer>();
            
            // Force component initialization
            var awakeMethod = typeof(MapleCharacterRenderer).GetMethod("Awake", 
                BindingFlags.NonPublic | BindingFlags.Instance);
            if (awakeMethod != null)
            {
                awakeMethod.Invoke(renderer, null);
                results.AppendLine("Called Awake on renderer");
            }
            
            // Set character appearance
            renderer.SetCharacterAppearance(0, 20000, 30000);
            results.AppendLine("Set character appearance (skin: 0, face: 20000, hair: 30000)");
            
            // Force sprite update
            var updateSpritesMethod = typeof(MapleCharacterRenderer).GetMethod("UpdateSprites", 
                BindingFlags.NonPublic | BindingFlags.Instance);
            if (updateSpritesMethod != null)
            {
                updateSpritesMethod.Invoke(renderer, null);
                results.AppendLine("Forced UpdateSprites");
            }
            
            // Wait a frame for Unity to process transforms
            System.Threading.Thread.Sleep(100);
            
            // Analyze face offset
            Debug.Log("\n=== ANALYZING FACE OFFSET ===");
            results.AppendLine("\n=== ANALYZING FACE OFFSET ===");
            
            // Find face transform
            Transform face = null;
            
            // Check all possible locations
            face = characterObj.transform.Find("Face");
            if (face == null)
            {
                Transform head = characterObj.transform.Find("Head");
                if (head != null)
                {
                    face = head.Find("Face");
                    results.AppendLine("Found Face under Head");
                }
            }
            else
            {
                results.AppendLine("Found Face directly under character");
            }
            
            if (face != null)
            {
                Vector3 faceWorldPos = face.position;
                Vector3 faceLocalPos = face.localPosition;
                
                results.AppendLine($"\nFace Transform Found:");
                results.AppendLine($"  Local Position: {faceLocalPos}");
                results.AppendLine($"  World Position: {faceWorldPos}");
                
                // Get face renderer info
                var faceSR = face.GetComponent<SpriteRenderer>();
                if (faceSR != null && faceSR.sprite != null)
                {
                    results.AppendLine($"  Sprite: {faceSR.sprite.name}");
                    results.AppendLine($"  Sprite pivot: {faceSR.sprite.pivot}");
                    results.AppendLine($"  Sprite bounds: {faceSR.sprite.bounds}");
                    results.AppendLine($"  Sprite rect: {faceSR.sprite.rect}");
                }
                
                // Calculate total offset from character origin
                Vector3 totalOffset = face.position - characterObj.transform.position;
                results.AppendLine($"\nTotal offset from character origin: {totalOffset}");
                
                // Convert to pixels (100 pixels per unit)
                Vector2 pixelOffset = new Vector2(totalOffset.x * 100, totalOffset.y * 100);
                results.AppendLine($"Face pixel offset: ({pixelOffset.x:F1}, {pixelOffset.y:F1})");
                
                // Expected C++ offset
                Vector2 expectedPixels = new Vector2(-8, -52);
                results.AppendLine($"Expected C++ offset: ({expectedPixels.x}, {expectedPixels.y})");
                
                float distance = Vector2.Distance(pixelOffset, expectedPixels);
                results.AppendLine($"Distance from expected: {distance:F2} pixels");
                
                if (distance < 1f)
                {
                    results.AppendLine("\n✓ TEST PASSED: Face offset MATCHES C++ runtime!");
                    Debug.Log("✓ TEST PASSED: Face offset MATCHES C++ runtime!");
                }
                else
                {
                    results.AppendLine($"\n✗ TEST FAILED: Face offset mismatch");
                    results.AppendLine($"  Difference: ({pixelOffset.x - expectedPixels.x:F1}, {pixelOffset.y - expectedPixels.y:F1}) pixels");
                    Debug.LogWarning($"✗ TEST FAILED: Face offset mismatch - Expected {expectedPixels}, Got {pixelOffset}");
                }
                
                // Log attachment points being used
                results.AppendLine("\n=== ATTACHMENT POINTS DEBUG ===");
                var attachmentPointsField = typeof(MapleCharacterRenderer).GetField("currentAttachmentPoints", 
                    BindingFlags.NonPublic | BindingFlags.Instance);
                if (attachmentPointsField != null)
                {
                    var attachmentPoints = attachmentPointsField.GetValue(renderer) as System.Collections.Generic.Dictionary<string, Vector2>;
                    if (attachmentPoints != null)
                    {
                        results.AppendLine($"Total attachment points: {attachmentPoints.Count}");
                        foreach (var kvp in attachmentPoints)
                        {
                            results.AppendLine($"  {kvp.Key}: {kvp.Value}");
                        }
                    }
                }
            }
            else
            {
                results.AppendLine("\n✗ TEST FAILED: Face transform not found!");
                Debug.LogError("Face transform not found!");
            }
            
            // Log full character hierarchy
            results.AppendLine("\n=== FULL CHARACTER HIERARCHY ===");
            LogHierarchy(characterObj.transform, 0, results);
            
            // Write results
            File.WriteAllText(logPath, results.ToString());
            Debug.Log($"Test results written to: {logPath}");
            
            // Clean up
            GameObject.DestroyImmediate(characterObj);
            
            EditorApplication.Exit(0);
        }
        catch (System.Exception e)
        {
            string error = $"Test failed with exception: {e.Message}\n{e.StackTrace}";
            Debug.LogError(error);
            results.AppendLine($"\nFATAL ERROR: {error}");
            File.WriteAllText(logPath, results.ToString());
            EditorApplication.Exit(1);
        }
    }
    
    private static void LogHierarchy(Transform t, int depth, System.Text.StringBuilder sb)
    {
        string indent = new string(' ', depth * 2);
        var sr = t.GetComponent<SpriteRenderer>();
        string spriteInfo = sr != null && sr.sprite != null ? $" [Sprite: {sr.sprite.name}]" : "";
        sb.AppendLine($"{indent}{t.name}: {t.localPosition}{spriteInfo}");
        
        foreach (Transform child in t)
        {
            LogHierarchy(child, depth + 1, sb);
        }
    }
}